# Configurações do Restaurante (Dados fictícios de demonstração)
# Copie este arquivo para .env.local para sobrescrever os valores padrão em ambiente local ou configure na Vercel.

# Número do WhatsApp com DDI (55) + DDD (12) + Número (apenas dígitos: +55 (12) 99102-6455)
NEXT_PUBLIC_WHATSAPP_NUMBER=5512991026455

# Taxa fixa única de entrega em reais (use ponto como separador decimal)
NEXT_PUBLIC_DELIVERY_FEE=9.90
